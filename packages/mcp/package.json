{
  "name": "hash-design-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Private wrapper: runs the hash-design MCP server (`hash-design mcp`) from a checkout as packages/mcp/dist/bin.js.",
  "license": "MIT",
  "author": "qybaihe",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qybaihe/hash-design.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/qybaihe/hash-design#readme",
  "bugs": "https://github.com/qybaihe/hash-design/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design",
    "ai",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "hash-design-mcp": "dist/bin.js"
  },
  "files": [
    "dist",
    "!dist/.tsbuildinfo",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "hash-design": "^0.1.0"
  }
}

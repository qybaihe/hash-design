{
  "name": "hash-design-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server (stdio) for hash-design: roll random design directions, reproduce briefs, browse the branch library, critique pages for AI-template tells.",
  "license": "MIT",
  "author": "qybaihe",
  "type": "module",
  "repository": {
    "type": "git",

{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "hash-design/browser": ["../packages/core/src/browser.ts"]
    }
  },
  "include": ["src/**/*.ts", "build/**/*.ts", "test/**/*.ts", "vite.config.ts"]
}
